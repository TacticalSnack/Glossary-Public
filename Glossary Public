<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Arboricultural Glossary</title>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Righteous&display=swap" rel="stylesheet">
<style>
:root {
  --forest-dark: #1A302C;
  --accent: #E1BE7C;
  --bg: #ffffff;
  --card: #ffffff;
  --text: #1A302C;
  --muted: #5a6b66;
  --border: #e8e0d0;
  --forest-pale: #f0e6c8;
  --danger: #bc4749;
  --warn: #e9c46a;
  --ok: #2a9d8f;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: Lato, system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  min-height: 100vh;
}
header {
  background: var(--forest-dark);
  padding: 1.75rem 1.5rem;
  text-align: center;
}
header h1 {
  font-family: Righteous, system-ui, sans-serif;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #fff;
  font-size: 1.75rem;
  margin-bottom: 0.35rem;
}
header .subtitle {
  font-family: Lato, system-ui, sans-serif;
  color: var(--accent);
  font-size: 0.95rem;
  max-width: 720px;
  margin: 0 auto;
}
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem;
}
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.25rem 1.4rem;
  box-shadow: 0 2px 8px rgba(27, 67, 50, 0.06);
  margin-bottom: 1.25rem;
}
.card h2 {
  font-family: Righteous, system-ui, sans-serif;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-size: 1.15rem;
  border-bottom: 2px solid var(--accent);
  padding-bottom: 0.4rem;
  margin-bottom: 1rem;
  color: var(--forest-dark);
}
.filters {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
@media (max-width: 820px) {
  .filters { grid-template-columns: 1fr; }
}
.input-row { margin-bottom: 0.9rem; }
label {
  display: block;
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--forest-dark);
  margin-bottom: 0.35rem;
}
input[type="search"],
input[type="text"],
select {
  width: 100%;
  padding: 0.55rem 0.75rem;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  font-family: Lato, system-ui, sans-serif;
  font-size: 1rem;
  color: var(--text);
  background: #fff;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}
input[type="search"]:focus,
input[type="text"]:focus,
select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(225, 190, 124, 0.35);
}
.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 0.5rem;
}
button {
  font-family: Lato, system-ui, sans-serif;
  font-weight: 700;
  padding: 0.6rem 1.1rem;
  border-radius: 8px;
  cursor: pointer;
  border: none;
  transition: transform 0.12s, background 0.15s;
}
button:hover { transform: translateY(-1px); }
.btn-primary {
  background: var(--forest-dark);
  color: #fff;
}
.btn-primary:hover { background: #0f1f1c; }
.btn-secondary {
  background: #fff;
  color: var(--forest-dark);
  border: 1.5px solid var(--accent);
}
.btn-secondary:hover { background: #f5f0e6; }
.stats {
  font-size: 0.85rem;
  color: var(--muted);
  margin-bottom: 0.75rem;
}
.stats strong { color: var(--forest-dark); }
.glossary-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.entry {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0.9rem 1.1rem;
  background: #fff;
  transition: box-shadow 0.15s;
}
.entry:hover {
  box-shadow: 0 2px 10px rgba(27, 67, 50, 0.08);
}
.entry-header {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.5rem 0.85rem;
  margin-bottom: 0.35rem;
}
.term {
  font-family: Righteous, system-ui, sans-serif;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  font-size: 1.05rem;
  color: var(--forest-dark);
}
.topic-badge {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  background: #f0e6c8;
  color: var(--forest-dark);
  border: 1px solid var(--border);
}
.definition {
  font-size: 0.95rem;
  color: var(--text);
  line-height: 1.55;
}
.highlight {
  background: rgba(225, 190, 124, 0.45);
  border-radius: 2px;
  padding: 0 1px;
}
.empty {
  text-align: center;
  padding: 2.5rem 1rem;
  color: var(--muted);
  font-size: 1rem;
}
.letter-jump {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
  margin-bottom: 1rem;
}
.letter-jump a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 1.85rem;
  height: 1.85rem;
  padding: 0 0.35rem;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 700;
  text-decoration: none;
  color: var(--forest-dark);
  background: #faf6eb;
  border: 1px solid var(--border);
  cursor: pointer;
  user-select: none;
}
.letter-jump a.letter-all {
  min-width: auto;
  padding: 0 0.55rem;
}
.letter-jump a:hover {
  background: #f5f0e6;
  border-color: var(--accent);
}
.letter-jump a.active {
  background: var(--forest-dark);
  color: #fff;
  border-color: var(--forest-dark);
}
.letter-jump a.disabled {
  opacity: 0.35;
  pointer-events: none;
}
.letter-heading {
  font-family: Righteous, system-ui, sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 1.1rem;
  color: var(--accent);
  margin: 1.25rem 0 0.5rem;
  padding-bottom: 0.25rem;
  border-bottom: 1px solid var(--border);
}
.letter-heading:first-child { margin-top: 0; }
footer {
  text-align: center;
  color: var(--muted);
  font-size: 0.8rem;
  border-top: 1px solid var(--border);
  padding: 1.5rem;
  margin-top: 2rem;
  max-width: 1100px;
  margin-left: auto;
  margin-right: auto;
}
.note {
  font-size: 0.8rem;
  color: var(--muted);
  margin-top: 0.35rem;
}
mark.search-hit {
  background: rgba(225, 190, 124, 0.55);
  color: inherit;
  padding: 0 2px;
  border-radius: 2px;
}
</style>
</head>
<body>
<header>
  <h1>Arboricultural Glossary</h1>
  <p class="subtitle">Definitions aligned with industry bodies and Australian Standards for professional tree assessment and management.</p>
</header>

<div class="container">
  <div class="card">
    <h2>Search &amp; Filter</h2>
    <div class="filters">
      <div class="input-row">
        <label for="search">Search term or definition</label>
        <input type="search" id="search" placeholder="e.g. canopy, NRZ, decay…" autocomplete="off">
      </div>
      <div class="input-row">
        <label for="topic">Topic</label>
        <select id="topic">
          <option value="">All topics</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button type="button" class="btn-secondary" id="clearBtn">Clear filters</button>
    </div>
    <p class="note">Filter by topic or letter, and search across terms and definitions. Results update as you type.</p>
  </div>

  <div class="card">
    <div class="stats" id="stats">Loading…</div>
    <div class="letter-jump" id="letterJump" aria-label="Jump to letter"></div>
    <div class="glossary-list" id="list"></div>
  </div>
</div>

<footer>
  Professional reference only. Definitions summarise common arboricultural usage and standard alignment; always refer to the cited primary sources and current Standards for formal assessment and reporting.
</footer>

<script>
const GLOSSARY = [{"term": "Abaxial", "definition": "The surface of a leaf or organ facing away from the main axis; in leaves, usually the lower surface.", "topic": "Tree biology & anatomy"}, {"term": "Abscission", "definition": "The natural separation of a leaf, fruit, flower or other plant part from the parent plant.", "topic": "Tree biology & anatomy"}, {"term": "Absorptive root", "definition": "A fine root primarily involved in water and nutrient uptake rather than major structural support.", "topic": "Roots, soil & below-ground environment"}, {"term": "Acceptable risk", "definition": "A level of risk considered tolerable within the adopted management framework.", "topic": "Tree risk & assessment"}, {"term": "Accuracy", "definition": "The degree to which a measurement or estimate represents the actual value.", "topic": "Measurement, inventory & field terminology"}, {"term": "Acute union", "definition": "A branch or stem union forming a relatively narrow angle.", "topic": "Tree structure & form"}, {"term": "Adaptive growth", "definition": "Growth that changes tissue distribution or form in response to mechanical or environmental conditions.", "topic": "Tree structure & form"}, {"term": "Advanced assessment", "definition": "A specialist investigation using instruments, testing or diagnostic techniques to evaluate a specific tree condition.", "topic": "Tree risk & assessment"}, {"term": "Adventitious bud", "definition": "A bud arising from tissue or a position not normally associated with bud development.", "topic": "Tree biology & anatomy"}, {"term": "Adventitious root", "definition": "A root arising from a stem or other non-root tissue.", "topic": "Tree biology & anatomy"}, {"term": "Aerial root", "definition": "A root developing above ground, sometimes contributing to support, moisture uptake or specialised growth.", "topic": "Tree biology & anatomy"}, {"term": "Age distribution", "definition": "The relative representation of trees across different developmental or age classes.", "topic": "Urban forestry & tree management"}, {"term": "Age – Mature", "definition": "Tree within the principal mature phase of its expected life, with established form and biomass.", "topic": "Age / Tree development"}, {"term": "Age – Over-mature", "definition": "Tree beyond the principal mature phase, often showing senescence or progressive decline.", "topic": "Age / Tree development"}, {"term": "Age – Young", "definition": "Tree at an early stage of development; commonly assessed relative to expected lifespan and establishment.", "topic": "Age / Tree development"}, {"term": "Air excavation", "definition": "Removal of soil using compressed air to expose roots while minimising mechanical cutting.", "topic": "Development, construction & tree protection"}, {"term": "Alburnum", "definition": "Another term for sapwood, referring to the outer, physiologically active wood of a stem.", "topic": "Tree biology & anatomy"}, {"term": "Amenity tree", "definition": "A tree managed primarily for its contribution to amenity, environmental, social or functional values.", "topic": "Urban forestry & tree management"}, {"term": "Amenity value", "definition": "The social, visual, environmental or functional benefit provided by a tree.", "topic": "Urban forestry & tree management"}, {"term": "Anchor root", "definition": "A substantial root contributing significantly to resistance against overturning.", "topic": "Roots, soil & below-ground environment"}, {"term": "Angiosperm", "definition": "A flowering plant whose seeds develop within an ovary, usually forming a fruit.", "topic": "Tree biology & anatomy"}, {"term": "Annual ring", "definition": "A layer of secondary xylem produced during one growth period, often visible as a growth ring.", "topic": "Tree biology & anatomy"}, {"term": "Apical dominance", "definition": "Suppression of lateral bud growth by signals associated with an active shoot apex.", "topic": "Tree biology & anatomy"}, {"term": "Apical meristem", "definition": "A region of actively dividing cells at a shoot or root tip responsible for primary growth.", "topic": "Tree biology & anatomy"}, {"term": "Apical shoot", "definition": "A terminal shoot extending from the apex of a stem or branch.", "topic": "Tree biology & anatomy"}, {"term": "Arboricultural impact assessment", "definition": "A professional assessment of how proposed works may affect trees and the measures required to avoid or minimise adverse impacts.", "topic": "Development, construction & tree protection"}, {"term": "Arboricultural impact assessment (AIA) (AS 4970:2025)", "definition": "Under AS 4970:2025, a detailed assessment of how proposed development may affect trees, including NRZ/TPZ determinations, encroachment classification and recommended protection or mitigation measures.", "topic": "Development, construction & tree protection"}, {"term": "Arboricultural method statement", "definition": "A documented procedure specifying how works near trees are to be undertaken to protect trees and their root systems.", "topic": "Development, construction & tree protection"}, {"term": "Arboricultural survey", "definition": "Field investigation recording tree attributes relevant to arboricultural management or assessment.", "topic": "Measurement, inventory & field terminology"}, {"term": "Arboriculture", "definition": "The science, art and practice of managing trees and woody plants in the built and managed environment.", "topic": "General"}, {"term": "Arborist", "definition": "A person trained and experienced in the techniques and hazards associated with arboricultural work.", "topic": "General"}, {"term": "Assessment period", "definition": "The time interval over which a risk estimate or management recommendation applies.", "topic": "Tree risk & assessment"}, {"term": "Assessment uncertainty", "definition": "The degree to which available information, observation or prediction may differ from the actual condition or outcome.", "topic": "Tree risk & assessment"}, {"term": "Asset tree", "definition": "A tree considered an asset within an organisation's broader asset-management framework.", "topic": "Urban forestry & tree management"}, {"term": "Attribute table", "definition": "A tabular dataset containing information associated with mapped features.", "topic": "Measurement, inventory & field terminology"}, {"term": "Axillary bud", "definition": "A bud located in the axil between a leaf and its associated stem.", "topic": "Tree biology & anatomy"}, {"term": "Bacterial wetwood", "definition": "A condition involving bacterial activity and altered moisture or chemistry within wood, sometimes producing liquid or odour.", "topic": "Defects, decay & disorders"}, {"term": "Bark", "definition": "The tissues outside the vascular cambium, including secondary phloem and protective outer tissues.", "topic": "Tree biology & anatomy"}, {"term": "Bark inclusion", "definition": "A condition in which bark becomes enclosed between adjoining stems or branches at a union.", "topic": "Tree biology & anatomy"}, {"term": "Basal diameter", "definition": "The diameter of a stem measured near its base at a defined height above ground.", "topic": "Measurement, inventory & field terminology"}, {"term": "Bifurcation", "definition": "A division of a stem or branch into two principal axes.", "topic": "Tree biology & anatomy"}, {"term": "Biodiversity value", "definition": "The contribution of a tree or vegetation population to biological diversity.", "topic": "Urban forestry & tree management"}, {"term": "Bleeding", "definition": "Exudation of sap, resin, gum or other fluid from a wound, crack or affected tissue.", "topic": "Defects, decay & disorders"}, {"term": "Bole", "definition": "The main stem or trunk of a tree, particularly the portion below the principal crown.", "topic": "Tree biology & anatomy"}, {"term": "Branch aspect", "definition": "The compass direction or orientation toward which a branch extends.", "topic": "Measurement, inventory & field terminology"}, {"term": "Branch attachment", "definition": "The structural connection between a branch and its parent stem or branch.", "topic": "Tree structure & form"}, {"term": "Branch bark ridge", "definition": "A ridge of bark formed in a branch union, generally indicating the orientation of the branch attachment.", "topic": "Tree structure"}, {"term": "Branch cleaning", "definition": "Selective removal of unwanted branch material while retaining sound structural components.", "topic": "Pruning & tree work"}, {"term": "Branch collar", "definition": "The swollen area at the base of a branch associated with the branch-trunk or branch-parent connection.", "topic": "Tree structure"}, {"term": "Branch collar cut", "definition": "A removal cut made close to the branch collar while avoiding unnecessary injury to the parent stem.", "topic": "Pruning & tree work"}, {"term": "Branch diameter", "definition": "The diameter of a branch measured at a specified point.", "topic": "Measurement, inventory & field terminology"}, {"term": "Branch end-weight", "definition": "Concentration of branch and foliage mass toward the distal portion of a branch.", "topic": "Tree structure & form"}, {"term": "Branch failure", "definition": "Structural failure or detachment of a branch or branch component.", "topic": "Tree risk & assessment"}, {"term": "Branch length", "definition": "The distance from a branch attachment to a defined distal point.", "topic": "Measurement, inventory & field terminology"}, {"term": "Branch orientation", "definition": "The direction and angle in which a branch extends from its parent axis.", "topic": "Tree structure & form"}, {"term": "Branch reduction", "definition": "Selective shortening of a branch to reduce its length or leverage while retaining an appropriate branch structure.", "topic": "Pruning & tree work"}, {"term": "Branch removal", "definition": "Cutting a branch from its parent stem or branch as a deliberate pruning operation.", "topic": "Pruning & tree work"}, {"term": "Branch shortening", "definition": "Removal of part of a branch to reduce its overall length.", "topic": "Pruning & tree work"}, {"term": "Branch stub", "definition": "A remaining portion of a branch left after pruning or breakage.", "topic": "Tree structure & form"}, {"term": "Branch torsion", "definition": "Twisting stress or deformation experienced by a branch or stem.", "topic": "Tree structure & form"}, {"term": "Branch union", "definition": "The point or junction where a branch joins another branch or the trunk.", "topic": "Tree structure"}, {"term": "Brown rot", "definition": "A decay type in which fungi preferentially break down cellulose and hemicellulose, leaving relatively lignin-rich brown wood.", "topic": "Defects, decay & disorders"}, {"term": "Bud", "definition": "A developing shoot or flower structure containing meristematic tissue.", "topic": "Tree biology & anatomy"}, {"term": "Bud bank", "definition": "The reserve of dormant buds capable of producing new shoots when stimulated.", "topic": "Tree biology & anatomy"}, {"term": "Bulging", "definition": "Localised swelling of woody tissue associated with growth, reaction, injury or internal defects.", "topic": "Defects, decay & disorders"}, {"term": "Bulk density", "definition": "The mass of dry soil per unit volume, including pore spaces; an indicator of soil compaction.", "topic": "Roots, soil & below-ground environment"}, {"term": "Buttress root", "definition": "A large, often flattened root flare extending from the lower trunk into the surrounding soil.", "topic": "Tree biology & anatomy"}, {"term": "Callus", "definition": "Undifferentiated or developing tissue produced around a wound during the compartmentalisation and wound-response process.", "topic": "Tree biology"}, {"term": "Cambial zone", "definition": "The narrow region containing the vascular cambium and immediately associated developing tissues.", "topic": "Tree biology & anatomy"}, {"term": "Cambium", "definition": "A layer of meristematic tissue responsible for producing secondary xylem and phloem.", "topic": "Tree biology"}, {"term": "Canker", "definition": "A localised area of dead or damaged bark and cambium, often associated with pathogens or repeated injury.", "topic": "Defects, decay & disorders"}, {"term": "Canopy", "definition": "The collective crown or foliage-bearing portion of a tree or group of trees.", "topic": "Tree structure"}, {"term": "Canopy clearance", "definition": "The vertical or lateral distance maintained between foliage or branches and an adjacent object.", "topic": "Pruning & tree work"}, {"term": "Canopy conflict", "definition": "An actual or potential interaction between tree growth and buildings, infrastructure, vehicles, services or other assets.", "topic": "Development, construction & tree protection"}, {"term": "Canopy connectivity", "definition": "The degree to which tree crowns form continuous or connected habitat or shade networks.", "topic": "Urban forestry & tree management"}, {"term": "Canopy cover", "definition": "The proportion of a defined area covered by the vertical projection of tree crowns.", "topic": "Urban forestry & tree management"}, {"term": "Canopy encroachment", "definition": "Intrusion of a structure, service or other object into the existing or projected tree crown.", "topic": "Development, construction & tree protection"}, {"term": "Canopy equity", "definition": "The equitable distribution of tree canopy and its benefits among different communities or areas.", "topic": "Urban forestry & tree management"}, {"term": "Canopy gap", "definition": "An area within a tree canopy or canopy network lacking tree crown cover.", "topic": "Urban forestry & tree management"}, {"term": "Canopy target", "definition": "A defined desired level of tree canopy cover for a specified area and timeframe.", "topic": "Urban forestry & tree management"}, {"term": "Capillary water", "definition": "Water retained in soil pores by surface tension and generally available to plants within a range of soil conditions.", "topic": "Roots, soil & below-ground environment"}, {"term": "Cavity", "definition": "A void or hollow within woody tissue, generally associated with decay, injury or structural failure.", "topic": "Defects / decay"}, {"term": "Cellulose", "definition": "A structural polysaccharide forming a major component of plant cell walls.", "topic": "Tree biology & anatomy"}, {"term": "Chlorophyll", "definition": "A green pigment essential for capturing light energy during photosynthesis.", "topic": "Tree biology & anatomy"}, {"term": "Chloroplast", "definition": "The organelle in plant cells where photosynthesis occurs.", "topic": "Tree biology & anatomy"}, {"term": "Chlorosis", "definition": "Abnormal yellowing of normally green foliage caused by reduced chlorophyll or related physiological factors.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Circumference", "definition": "The distance measured around the outside of a tree stem.", "topic": "Measurement, inventory & field terminology"}, {"term": "Cleaning", "definition": "Pruning focused on removing dead, diseased, damaged, crossing or otherwise undesirable branches.", "topic": "Pruning & tree work"}, {"term": "Clearance height", "definition": "The vertical distance between the ground or another reference surface and the lowest relevant branch or foliage.", "topic": "Measurement, inventory & field terminology"}, {"term": "Clearance pruning", "definition": "Pruning undertaken to maintain a specified clearance from buildings, roads, utilities or other infrastructure.", "topic": "Pruning & tree work"}, {"term": "Codominant stems", "definition": "Two or more stems of approximately similar diameter competing for dominance, often forming a potentially weak union.", "topic": "Tree structure"}, {"term": "Cohesion", "definition": "The attraction between water molecules that contributes to continuity of the water column in xylem.", "topic": "Tree biology & anatomy"}, {"term": "Compaction layer", "definition": "A soil horizon or zone with increased density and reduced pore space caused by pressure or repeated traffic.", "topic": "Roots, soil & below-ground environment"}, {"term": "Companion cell", "definition": "A living phloem-associated cell that supports the function of sieve elements.", "topic": "Tree biology & anatomy"}, {"term": "Compartmentalisation", "definition": "The process by which a tree limits the spread of dysfunction, decay or injury through physiological and anatomical boundaries.", "topic": "Tree biology"}, {"term": "Compensatory planting", "definition": "New tree planting undertaken to offset or partially compensate for approved tree loss or impacts.", "topic": "Development, construction & tree protection"}, {"term": "Competent person", "definition": "A person with appropriate training, knowledge, experience and skill for the task being undertaken.", "topic": "Tree risk & assessment"}, {"term": "Compression crack", "definition": "A crack associated with compressive stress in wood, sometimes developing on the compressed side of a leaning or overloaded part.", "topic": "Defects, decay & disorders"}, {"term": "Condition", "definition": "An assessment of a tree's current structural and physiological state, including defects, vitality and stability.", "topic": "Assessment"}, {"term": "Conk", "definition": "A visible fungal fruiting structure, often produced by wood-decay fungi.", "topic": "Defects, decay & disorders"}, {"term": "Consequence", "definition": "The expected severity of harm or loss if a tree or tree part fails and affects a target.", "topic": "Tree risk & assessment"}, {"term": "Construction exclusion zone", "definition": "A defined area in which construction activity is restricted or prohibited to protect trees.", "topic": "Development, construction & tree protection"}, {"term": "Construction impact", "definition": "An adverse effect on a tree arising from construction activities or changed site conditions.", "topic": "Development, construction & tree protection"}, {"term": "Cork", "definition": "A protective, often suberised tissue produced by cork cambium.", "topic": "Tree biology & anatomy"}, {"term": "Cork cambium", "definition": "A lateral meristem producing protective cork and associated tissues in the outer bark.", "topic": "Tree biology & anatomy"}, {"term": "Crack", "definition": "A separation or discontinuity within bark or wood that may affect structural integrity.", "topic": "Defects, decay & disorders"}, {"term": "Critical root zone", "definition": "A defined root area considered particularly important to the survival, stability or function of a tree.", "topic": "Roots, soil & below-ground environment"}, {"term": "Crotch", "definition": "A branch junction or fork where two or more axes meet.", "topic": "Tree biology & anatomy"}, {"term": "Crown", "definition": "The branches, twigs and foliage of a tree above the stem or trunk.", "topic": "Tree structure"}, {"term": "Crown architecture", "definition": "The spatial arrangement and developmental pattern of stems, branches, foliage and shoots within a crown.", "topic": "Tree biology & anatomy"}, {"term": "Crown asymmetry", "definition": "A crown whose foliage or branch distribution is uneven around the main stem.", "topic": "Tree structure & form"}, {"term": "Crown base", "definition": "The approximate lowest point of the live or structural crown, depending on the defined measurement method.", "topic": "Measurement, inventory & field terminology"}, {"term": "Crown breakage", "definition": "Breakage of a branch, stem or crown component resulting in loss of part of the crown.", "topic": "Risk / structure"}, {"term": "Crown cleaning", "definition": "Selective removal of specified non-functional or defective crown components.", "topic": "Pruning & tree work"}, {"term": "Crown density", "definition": "The relative amount of foliage and branch material occupying the crown, assessed against expected form or comparable trees.", "topic": "Assessment"}, {"term": "Crown dieback", "definition": "Progressive death of branches and shoots, generally beginning in the outer or upper crown.", "topic": "Tree health"}, {"term": "Crown eccentricity", "definition": "Unequal radial development of a crown, often associated with light, competition or mechanical loading.", "topic": "Tree structure & form"}, {"term": "Crown form", "definition": "The overall three-dimensional shape and architecture of a tree crown.", "topic": "Tree structure & form"}, {"term": "Crown height", "definition": "The vertical height of the crown above a defined reference point.", "topic": "Tree structure & form"}, {"term": "Crown lifting (C) (AS 4373)", "definition": "Crown-modification pruning that removes or shortens lower branches to increase vertical clearance beneath the crown (AS 4373-2007).", "topic": "Pruning & tree work"}, {"term": "Crown maintenance (AS 4373)", "definition": "Pruning that retains the structure and size of the tree and does not reduce crown volume; includes deadwooding, crown thinning, selective pruning and formative pruning of young trees (AS 4373-2007).", "topic": "Pruning & tree work"}, {"term": "Crown modification (AS 4373)", "definition": "Pruning that changes the structural appearance and growth habit of the tree; includes reduction pruning, crown lifting, pollarding, remedial (restorative) pruning and line clearance (AS 4373-2007).", "topic": "Pruning & tree work"}, {"term": "Crown projection", "definition": "The area represented by the horizontal projection of the crown onto the ground.", "topic": "Tree structure & form"}, {"term": "Crown raising", "definition": "Pruning that removes or shortens lower branches to increase clearance beneath the crown.", "topic": "Pruning"}, {"term": "Crown reduction", "definition": "Pruning intended to reduce the overall dimensions of a crown while retaining an appropriate natural form.", "topic": "Pruning"}, {"term": "Crown response", "definition": "Changes in foliage, shoot production or architecture associated with stress, injury or environmental conditions.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Crown restoration", "definition": "Pruning intended to improve the structure and form of a previously damaged or poorly pruned crown.", "topic": "Pruning & tree work"}, {"term": "Crown retrenchment", "definition": "Reduction of crown dimensions through selective pruning that retains a natural, lower-density crown structure.", "topic": "Pruning & tree work"}, {"term": "Crown shaping", "definition": "Pruning undertaken to modify crown form for a defined aesthetic, clearance or management objective.", "topic": "Pruning & tree work"}, {"term": "Crown spread", "definition": "The horizontal extent of a tree crown, commonly recorded in two perpendicular directions.", "topic": "Tree structure & form"}, {"term": "Crown thinning", "definition": "Selective removal of branches to reduce density while retaining the tree's natural crown form.", "topic": "Pruning"}, {"term": "Crown thinning (T) (AS 4373)", "definition": "Crown-maintenance pruning class that reduces canopy density by selective removal of lower-order branches while retaining the main structural branches and overall crown size (AS 4373-2007).", "topic": "Pruning & tree work"}, {"term": "Crown transparency", "definition": "The proportion of visible light or background visible through a crown, used as an indicator of foliage density.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Crown width", "definition": "The measured lateral dimension of a tree crown.", "topic": "Tree structure & form"}, {"term": "Cuticle", "definition": "A waxy protective layer on the surface of leaves and young stems that limits water loss.", "topic": "Tree biology & anatomy"}, {"term": "Dead branch", "definition": "A branch containing no living vascular or foliage-producing tissue.", "topic": "Tree structure & form"}, {"term": "Deadwood", "definition": "Branches or portions of branches that are dead and no longer physiologically active.", "topic": "Tree health"}, {"term": "Deadwooding", "definition": "Removal of dead branches or dead portions of branches.", "topic": "Pruning & tree work"}, {"term": "Deadwooding (D) (AS 4373)", "definition": "Crown-maintenance pruning class consisting of the selective removal of dead branches; minimum diameter and location of branches to be removed should be specified (AS 4373-2007).", "topic": "Pruning & tree work"}, {"term": "Decay", "definition": "The decomposition or degradation of woody tissue, usually involving fungi and associated microorganisms.", "topic": "Defects / decay"}, {"term": "Decay column", "definition": "A longitudinal region of degraded wood extending through part of a stem or branch.", "topic": "Defects, decay & disorders"}, {"term": "Decay pocket", "definition": "A localised area of decayed wood surrounded by more intact tissue.", "topic": "Defects, decay & disorders"}, {"term": "Defect", "definition": "A structural, biological or physical feature that may reduce the strength, function, vitality or stability of a tree or tree part.", "topic": "Risk / structure"}, {"term": "Defoliation", "definition": "Loss of leaves or foliage from a tree, whether natural, seasonal or stress-related.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Deliquescent", "definition": "Having a branching architecture in which the main stem loses dominance and divides into several major branches.", "topic": "Tree biology & anatomy"}, {"term": "Deliquescent crown", "definition": "A crown in which the main stem divides into several similarly important structural axes.", "topic": "Tree structure & form"}, {"term": "Detailed assessment", "definition": "A more intensive assessment involving additional investigation beyond a basic visual inspection.", "topic": "Tree risk & assessment"}, {"term": "Development footprint", "definition": "The area occupied or directly affected by proposed buildings, pavements, services and associated works.", "topic": "Development, construction & tree protection"}, {"term": "Diameter", "definition": "The straight-line distance across a circular or approximately circular stem through its centre.", "topic": "Measurement, inventory & field terminology"}, {"term": "Diameter at breast height (DBH)", "definition": "Tree stem diameter conventionally measured at breast height (historically 1.4 m). AS 4970:2025 uses the equivalent term Diameter at Standard Height (DSH) for the same measurement location; the report should state the measurement convention used.", "topic": "Measurement, inventory & field terminology"}, {"term": "Diameter at ground level", "definition": "Stem diameter measured at or near ground level according to a stated method.", "topic": "Measurement, inventory & field terminology"}, {"term": "Diameter at standard height (DSH)", "definition": "Trunk or stem diameter measured at 1.4 m above ground level; the measurement convention used in AS 4970:2025 in place of the former DBH term (measurement location remains the same).", "topic": "Measurement, inventory & field terminology"}, {"term": "Diameter below branching", "definition": "Stem diameter measured below a low branching point where conventional measurement is not practicable.", "topic": "Measurement, inventory & field terminology"}, {"term": "Dieback", "definition": "Progressive death of shoots, branches or portions of a crown from their distal ends toward the base.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Diffuse-porous", "definition": "Wood in which vessels are relatively evenly distributed through the growth ring rather than concentrated in a distinct earlywood band.", "topic": "Tree biology & anatomy"}, {"term": "Direct impact", "definition": "Physical contact, excavation, severance or other immediate disturbance affecting a tree or its root system.", "topic": "Development, construction & tree protection"}, {"term": "Directional drilling", "definition": "Trenchless installation technique using a guided bore beneath the ground surface.", "topic": "Development, construction & tree protection"}, {"term": "Discoloration", "definition": "A visible change in colour of wood, bark, foliage or other tissue that may indicate physiological or biological change.", "topic": "Defects, decay & disorders"}, {"term": "Disease", "definition": "A condition in which normal plant function is disrupted by a pathogen, environmental factor or physiological disorder.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Disease cycle", "definition": "The sequence of events by which a disease develops, persists and spreads between host and environment.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Dormancy", "definition": "A temporary reduction or suspension of visible growth associated with environmental or physiological conditions.", "topic": "Tree biology & anatomy"}, {"term": "Dripline", "definition": "The approximate ground line corresponding to the outer extent of a tree crown, often used as a practical reference for root-zone discussions.", "topic": "Roots, soil & below-ground environment"}, {"term": "Drop-crotch pruning", "definition": "Reduction pruning performed back to a suitable lateral branch rather than leaving an arbitrary stub.", "topic": "Pruning & tree work"}, {"term": "Dry rot", "definition": "A general term historically applied to fungal decay producing dry, degraded wood; the specific causal organism should be identified where possible.", "topic": "Defects, decay & disorders"}, {"term": "Ecosystem service", "definition": "A benefit people obtain from ecosystem processes and functions.", "topic": "Urban forestry & tree management"}, {"term": "Encroachment", "definition": "Intrusion of proposed or existing works into a defined tree protection or root-zone area.", "topic": "Development, construction & tree protection"}, {"term": "Environmental benefit", "definition": "A benefit arising from tree functions such as shade, cooling, habitat, stormwater interception or carbon storage.", "topic": "Urban forestry & tree management"}, {"term": "Environmental stress", "definition": "Stress caused by external conditions such as drought, heat, flooding, salinity, pollution or compaction.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Epicormic branch", "definition": "A branch arising from an epicormic shoot or dormant bud on an older stem or branch.", "topic": "Tree structure & form"}, {"term": "Epicormic growth", "definition": "Shoots arising from dormant or adventitious buds on stems or branches, often following stress, pruning or damage.", "topic": "Tree growth"}, {"term": "Epicormic response", "definition": "Production of shoots from dormant or adventitious buds following stress, injury, pruning or altered light conditions.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Epicormic shoot removal", "definition": "Pruning of epicormic shoots for a defined management purpose.", "topic": "Pruning & tree work"}, {"term": "Epidermis", "definition": "The outermost cell layer covering young plant organs.", "topic": "Tree biology & anatomy"}, {"term": "Estimated measurement", "definition": "A value inferred or approximated where direct measurement is impracticable.", "topic": "Measurement, inventory & field terminology"}, {"term": "Eutrophication", "definition": "Enrichment of water or soil with nutrients that can alter plant and ecosystem processes.", "topic": "Tree biology & anatomy"}, {"term": "Exotic tree", "definition": "A tree species introduced outside its natural geographic distribution.", "topic": "Urban forestry & tree management"}, {"term": "Failure", "definition": "The structural breakage or loss of function of a tree or tree part.", "topic": "Risk / structure"}, {"term": "Failure consequence", "definition": "The type and severity of harm expected if a failure affects a target.", "topic": "Tree risk & assessment"}, {"term": "Failure mode", "definition": "The specific manner in which a tree or tree part may lose structural integrity.", "topic": "Tree risk & assessment"}, {"term": "Failure potential", "definition": "The assessed propensity of a tree or tree part to fail under foreseeable loading.", "topic": "Tree risk & assessment"}, {"term": "Failure probability", "definition": "An estimate of the probability of a specified failure occurring within a defined period.", "topic": "Tree risk & assessment"}, {"term": "Fascicle", "definition": "A bundle or cluster of structures, such as needles or vascular tissues, arising together.", "topic": "Tree biology & anatomy"}, {"term": "Fibre", "definition": "An elongated cell or tissue element contributing to mechanical support in wood.", "topic": "Tree biology & anatomy"}, {"term": "Field capacity", "definition": "The approximate soil water content remaining after excess gravitational drainage has largely ceased.", "topic": "Roots, soil & below-ground environment"}, {"term": "Field observation", "definition": "A condition or characteristic directly observed during an inspection.", "topic": "Measurement, inventory & field terminology"}, {"term": "Final cut", "definition": "The completed pruning cut made after preliminary removal of a branch's weight.", "topic": "Pruning & tree work"}, {"term": "Fine root", "definition": "A small-diameter root generally important for water and nutrient uptake.", "topic": "Roots, soil & below-ground environment"}, {"term": "Foliage density", "definition": "The amount of leaf material occupying a crown relative to expected or reference conditions.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Foliar symptom", "definition": "A visible change in leaves associated with stress, pest activity, disease or nutritional imbalance.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Fork", "definition": "A division of one stem or branch into two or more axes.", "topic": "Tree structure & form"}, {"term": "Forked stem", "definition": "A stem that divides into two or more major axes at a fork.", "topic": "Tree structure & form"}, {"term": "Formative pruning", "definition": "Pruning of young or developing trees to establish desirable structure and form.", "topic": "Pruning & tree work"}, {"term": "Formative pruning (F) (AS 4373)", "definition": "Crown-maintenance pruning of young or establishing trees to develop desirable structure, form and branch hierarchy (AS 4373-2007).", "topic": "Pruning & tree work"}, {"term": "Fruiting body", "definition": "A reproductive structure produced by a fungus, sometimes visible on a tree.", "topic": "Defects, decay & disorders"}, {"term": "Fungal decay", "definition": "Degradation of wood or other tissues by fungi.", "topic": "Defects, decay & disorders"}, {"term": "Fungal fruiting structure", "definition": "A structure produced by a fungus for reproduction, such as a mushroom, bracket or conk.", "topic": "Defects, decay & disorders"}, {"term": "Future canopy conflict", "definition": "A predicted future interaction resulting from expected tree growth or site change.", "topic": "Development, construction & tree protection"}, {"term": "Genetic diversity", "definition": "Variation in genetic characteristics within and between tree populations.", "topic": "Urban forestry & tree management"}, {"term": "Geocell", "definition": "A cellular ground-reinforcement system that can help distribute surface loads while limiting excavation.", "topic": "Development, construction & tree protection"}, {"term": "Georeferencing", "definition": "Assigning geographic coordinates or a spatial reference to mapped information.", "topic": "Measurement, inventory & field terminology"}, {"term": "Girdling root", "definition": "A root that grows around or presses against the trunk or another major root and may restrict vascular function.", "topic": "Defects, decay & disorders"}, {"term": "GIS", "definition": "A geographic information system used to capture, manage, analyse and display spatial information.", "topic": "Measurement, inventory & field terminology"}, {"term": "GPS", "definition": "A satellite-based positioning system used to determine geographic location.", "topic": "Measurement, inventory & field terminology"}, {"term": "Gravitational water", "definition": "Water that moves through soil under gravity and is generally less available for long-term plant uptake.", "topic": "Roots, soil & below-ground environment"}, {"term": "Green infrastructure", "definition": "A network of natural and designed vegetated systems providing environmental, social and functional services.", "topic": "Urban forestry & tree management"}, {"term": "Growth increment", "definition": "The amount of new growth produced over a defined period.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Growth stress", "definition": "Internal stress associated with the development and maturation of wood, sometimes contributing to cracking or movement after cutting.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Gummosis", "definition": "Exudation of gum or resinous material from plant tissues, commonly associated with stress, injury or disease.", "topic": "Defects, decay & disorders"}, {"term": "Habitat value", "definition": "The contribution of a tree or tree population to shelter, nesting, feeding or other habitat functions.", "topic": "Urban forestry & tree management"}, {"term": "Hazard", "definition": "A tree condition or circumstance with potential to cause harm.", "topic": "Tree risk & assessment"}, {"term": "Hazardous tree", "definition": "A tree presenting a significant hazard under defined circumstances; the term should be supported by an assessment of likelihood and consequence.", "topic": "Tree risk & assessment"}, {"term": "Heading cut", "definition": "A pruning cut made back to a bud, stub or lateral branch that is generally too small to assume dominance of the remaining branch.", "topic": "Pruning & tree work"}, {"term": "Health", "definition": "The overall biological state of a tree, including absence or presence of disease, pests and physiological dysfunction.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Heart rot", "definition": "Decay occurring primarily within the inner wood of a stem or branch.", "topic": "Defects, decay & disorders"}, {"term": "Heartwood", "definition": "The inner, generally non-living wood of a stem that has undergone physiological and chemical changes.", "topic": "Tree biology & anatomy"}, {"term": "Height", "definition": "The vertical distance from a defined ground reference to the highest point of a tree or tree part.", "topic": "Measurement, inventory & field terminology"}, {"term": "Hemicellulose", "definition": "A group of cell-wall polysaccharides associated with cellulose and lignin.", "topic": "Tree biology & anatomy"}, {"term": "Heritage tree", "definition": "A tree recognised for historical, cultural, social, scientific or commemorative significance.", "topic": "Urban forestry & tree management"}, {"term": "Hold point", "definition": "A specified stage of construction at which work must stop until a required inspection, approval or condition is satisfied.", "topic": "Development, construction & tree protection"}, {"term": "Hollow", "definition": "An internal void in woody tissue resulting from decay, excavation, breakage or other processes.", "topic": "Defects, decay & disorders"}, {"term": "Hydro excavation", "definition": "Removal of soil using pressurised water and suction equipment to expose underground services or roots.", "topic": "Development, construction & tree protection"}, {"term": "Hydrophobic soil", "definition": "Soil with reduced water infiltration caused by water-repellent surfaces or substances.", "topic": "Roots, soil & below-ground environment"}, {"term": "Impact potential", "definition": "The potential for a failed tree part to reach or affect a target.", "topic": "Tree risk & assessment"}, {"term": "Impact probability", "definition": "An estimate of the probability that a failed component will affect the target.", "topic": "Tree risk & assessment"}, {"term": "Included bark", "definition": "Bark enclosed between two stems or branches with a narrow or acute union, potentially reducing attachment strength.", "topic": "Tree structure"}, {"term": "Included union", "definition": "A union where bark is enclosed between adjoining stems or branches, potentially reducing attachment quality.", "topic": "Tree structure & form"}, {"term": "Indirect impact", "definition": "A tree impact caused by changed site conditions rather than direct physical injury.", "topic": "Development, construction & tree protection"}, {"term": "Infection court", "definition": "An entry point or pathway through which a pathogen gains access to susceptible tissue.", "topic": "Defects, decay & disorders"}, {"term": "Infiltration", "definition": "Movement of water from the soil surface into the soil profile.", "topic": "Roots, soil & below-ground environment"}, {"term": "Insect gallery", "definition": "A tunnel or channel excavated by insects within bark or wood.", "topic": "Defects, decay & disorders"}, {"term": "Inspection", "definition": "A systematic observation of a tree or site for defined assessment purposes.", "topic": "Tree risk & assessment"}, {"term": "Inspection limitation", "definition": "A factor that restricts the ability to inspect or diagnose a tree condition fully.", "topic": "Tree risk & assessment"}, {"term": "Internode", "definition": "The section of stem between two successive nodes.", "topic": "Tree biology & anatomy"}, {"term": "Kino", "definition": "A dark, resinous or gum-like exudate produced by some plants, particularly eucalypts, often following injury.", "topic": "Defects, decay & disorders"}, {"term": "Landscape significance", "definition": "The contribution of a tree to the character, amenity, heritage or visual quality of a landscape.", "topic": "Urban forestry & tree management"}, {"term": "Lateral branch", "definition": "A branch arising from the side of a parent stem or branch.", "topic": "Tree structure & form"}, {"term": "Lateral reduction", "definition": "Reduction of a branch or stem back to an appropriately positioned lateral branch.", "topic": "Pruning & tree work"}, {"term": "Lateral root", "definition": "A root extending sideways from another root or the root crown.", "topic": "Roots, soil & below-ground environment"}, {"term": "Leader", "definition": "A dominant or principal stem or branch axis contributing to the tree's height and crown development.", "topic": "Tree structure"}, {"term": "Leader dominance", "definition": "The extent to which a principal stem or shoot maintains vertical and developmental dominance.", "topic": "Tree structure & form"}, {"term": "Leaf area", "definition": "The total surface area of leaves contributing to photosynthesis and transpiration.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Leaf litter", "definition": "Detached leaves accumulated on the ground beneath or around trees.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Leaf scorch", "definition": "Browning or death of leaf margins or tissues commonly associated with water stress, heat, salts or root dysfunction.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Lenticel", "definition": "A porous structure in bark facilitating gas exchange between internal tissues and the atmosphere.", "topic": "Tree biology & anatomy"}, {"term": "Lesion", "definition": "A localised area of abnormal or damaged tissue.", "topic": "Defects, decay & disorders"}, {"term": "Lignin", "definition": "A complex structural polymer deposited in secondary cell walls, contributing to wood strength and resistance to decay.", "topic": "Tree biology & anatomy"}, {"term": "Lignotuber", "definition": "A woody swelling at or below ground containing buds and stored resources, common in some Australian species.", "topic": "Tree biology & anatomy"}, {"term": "Likelihood of failure", "definition": "The estimated probability that a tree or tree part will fail within a specified period.", "topic": "Tree risk & assessment"}, {"term": "Likelihood of impact", "definition": "The estimated probability that a failed tree part will strike a specified target.", "topic": "Tree risk & assessment"}, {"term": "Line clearance (L) (AS 4373)", "definition": "Crown-modification pruning undertaken to maintain clearance from overhead utility lines or other infrastructure, typically using formative or reduction techniques (AS 4373-2007).", "topic": "Pruning & tree work"}, {"term": "Live crown", "definition": "The portion of the crown containing living foliage and physiologically active branches.", "topic": "Tree structure & form"}, {"term": "Live crown ratio", "definition": "The proportion of total tree height occupied by the live crown.", "topic": "Assessment"}, {"term": "Load distribution", "definition": "Spreading a construction or pavement load over a larger area to reduce local soil pressure.", "topic": "Development, construction & tree protection"}, {"term": "Locally indigenous tree", "definition": "A tree species naturally occurring within the relevant local ecological or geographic area.", "topic": "Urban forestry & tree management"}, {"term": "Lopping", "definition": "The indiscriminate or excessive cutting of branches, often producing large stubs and weak regrowth; generally regarded as poor practice.", "topic": "Pruning & tree work"}, {"term": "Lopping and topping (unacceptable practice)", "definition": "Indiscriminate cutting of branches or the main stem that leaves large stubs and substantially alters natural form; identified as unacceptable practice under AS 4373-2007.", "topic": "Pruning & tree work"}, {"term": "Macropore", "definition": "A relatively large soil pore that contributes to drainage and aeration.", "topic": "Roots, soil & below-ground environment"}, {"term": "Major branch", "definition": "A branch forming a significant component of the structural framework of a tree.", "topic": "Tree structure & form"}, {"term": "Major NRZ encroachment", "definition": "Under AS 4970:2025, proposed works affecting more than 20 % of the NRZ area, or any encroachment into the SRZ. Requires detailed arboricultural assessment, exploration of design alternatives and demonstration of tree viability; may involve non-destructive root investigation.", "topic": "Development, construction & tree protection"}, {"term": "Manual excavation", "definition": "Hand excavation undertaken where controlled exposure is required to reduce root damage.", "topic": "Development, construction & tree protection"}, {"term": "Measurement datum", "definition": "The specified reference surface, height or coordinate system used for measurement.", "topic": "Measurement, inventory & field terminology"}, {"term": "Measurement tolerance", "definition": "The acceptable range of variation associated with a measurement method.", "topic": "Measurement, inventory & field terminology"}, {"term": "Meristem", "definition": "Plant tissue containing actively dividing cells responsible for growth.", "topic": "Tree biology"}, {"term": "Meristematic tissue", "definition": "Plant tissue containing cells capable of active division and producing new growth.", "topic": "Tree biology & anatomy"}, {"term": "Mesophyll", "definition": "The internal photosynthetic tissue of a leaf between the upper and lower epidermis.", "topic": "Tree biology & anatomy"}, {"term": "Micropore", "definition": "A small soil pore that retains water and influences water availability.", "topic": "Roots, soil & below-ground environment"}, {"term": "Minor branch", "definition": "A smaller branch contributing to crown structure or foliage-bearing capacity.", "topic": "Tree structure & form"}, {"term": "Minor NRZ encroachment", "definition": "Under AS 4970:2025, proposed works affecting 10 % or less of the NRZ area, outside the SRZ and with no recent NRZ encroachments. Generally considered unlikely to cause significant impact to tree health, structure or longevity when standard protection measures are applied.", "topic": "Development, construction & tree protection"}, {"term": "Mistletoe", "definition": "A parasitic or hemiparasitic plant growing on a host tree and obtaining water and nutrients from it.", "topic": "Defects, decay & disorders"}, {"term": "Mitigation measure", "definition": "A practical action intended to reduce identified tree risk.", "topic": "Tree risk & assessment"}, {"term": "Moderate NRZ encroachment", "definition": "Under AS 4970:2025, proposed works affecting more than 10 % and up to 20 % of the NRZ area, outside the SRZ. Requires review by a project arborist and demonstration that the tree will remain viable, potentially including investigation and mitigation measures.", "topic": "Development, construction & tree protection"}, {"term": "Monitoring", "definition": "Repeated assessment over time to detect change in tree condition, defects or site circumstances.", "topic": "Tree risk & assessment"}, {"term": "Monitoring interval", "definition": "The recommended period between successive inspections or observations.", "topic": "Tree risk & assessment"}, {"term": "Mulch", "definition": "Organic or inorganic material placed on soil around trees to modify moisture, temperature, weeds and soil condition.", "topic": "Roots, soil & below-ground environment"}, {"term": "Multi-stem tree", "definition": "A tree with two or more substantial stems arising from the base or lower trunk.", "topic": "Measurement, inventory & field terminology"}, {"term": "Mushroom", "definition": "The visible fruiting body of certain fungi; its presence does not alone establish the extent or significance of decay.", "topic": "Defects, decay & disorders"}, {"term": "Mycorrhiza", "definition": "A symbiotic association between plant roots and fungi that can improve nutrient and water acquisition.", "topic": "Roots, soil & below-ground environment"}, {"term": "Mycorrhizal association", "definition": "The functional relationship between a plant and beneficial root-associated fungi.", "topic": "Roots, soil & below-ground environment"}, {"term": "Narrow branch angle", "definition": "A branch attachment angle substantially less than a right angle.", "topic": "Tree structure & form"}, {"term": "Necrosis", "definition": "Death of cells or tissues within a living organism.", "topic": "Defects, decay & disorders"}, {"term": "Node", "definition": "A point on a stem where leaves, buds or branches originate.", "topic": "Tree biology & anatomy"}, {"term": "Non-destructive root detection", "definition": "Methods used to identify roots without extensive excavation or severance.", "topic": "Development, construction & tree protection"}, {"term": "Non-porous wood", "definition": "Wood in which vessel distribution does not form a readily differentiated ring-porous pattern.", "topic": "Tree biology & anatomy"}, {"term": "Normal vigour", "definition": "Ability of a tree to maintain and sustain normal life processes and growth relative to its species and circumstances.", "topic": "Assessment"}, {"term": "Notional root zone (NRZ)", "definition": "Under AS 4970:2025, the calculated theoretical root-zone area used as the primary trigger for arboricultural input on a development site. NRZ radius = DSH × 12 (minimum 2 m, maximum 15 m), measured from the centre of the stem. Encroachment is assessed against the NRZ area.", "topic": "Development, construction & tree protection"}, {"term": "NRZ encroachment", "definition": "Works or change of use (temporary or permanent) proposed within an identified notional root zone (NRZ), above or below ground, regardless of work method or construction type; classified as minor, moderate or major under AS 4970:2025 according to the proportion of NRZ area affected and any SRZ involvement.", "topic": "Development, construction & tree protection"}, {"term": "Nutrient deficiency", "definition": "Insufficient availability or uptake of an essential nutrient required for normal plant function.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Nutrient toxicity", "definition": "Physiological injury caused by excessive concentrations or uptake of a nutrient.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Occlusion", "definition": "The process by which growing tissue progressively surrounds or covers a wound or removed branch base.", "topic": "Defects, decay & disorders"}, {"term": "Order of branches", "definition": "A classification describing branch position within a hierarchy from the main stem outward.", "topic": "Tree structure & form"}, {"term": "Orthophoto", "definition": "An aerial image corrected for geometric distortion so that scale and position can be used spatially.", "topic": "Measurement, inventory & field terminology"}, {"term": "Parenchyma", "definition": "Living plant cells involved in storage, metabolism, wound response and other functions.", "topic": "Tree biology & anatomy"}, {"term": "Park tree", "definition": "A tree located within a public or private park or open-space landscape.", "topic": "Urban forestry & tree management"}, {"term": "Pathogen", "definition": "An organism capable of causing disease or dysfunction in a tree.", "topic": "Tree health"}, {"term": "Pathogen load", "definition": "The quantity or intensity of pathogenic organisms affecting a host.", "topic": "Defects, decay & disorders"}, {"term": "Pericycle", "definition": "A layer of cells in roots associated with formation of lateral roots and some secondary tissues.", "topic": "Tree biology & anatomy"}, {"term": "Periderm", "definition": "Protective secondary tissue replacing the epidermis as stems and roots increase in diameter.", "topic": "Tree biology & anatomy"}, {"term": "Permanent wilting point", "definition": "A soil moisture condition at which a plant cannot regain turgidity without additional water.", "topic": "Roots, soil & below-ground