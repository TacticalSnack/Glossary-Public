nition": "Reduction in trunk diameter with height, contributing to mechanical efficiency.", "topic": "Tree structure & form"}, {"term": "Undercut", "definition": "A preliminary cut made on the underside of a branch, commonly used to reduce bark tearing during removal.", "topic": "Pruning & tree work"}, {"term": "Urban forest", "definition": "The collective population of trees and associated vegetation within an urban area, including public and private land.", "topic": "Urban forestry & tree management"}, {"term": "Urban forestry", "definition": "The planning, establishment, management and protection of trees and forests within urban and peri-urban environments.", "topic": "Urban forestry & tree management"}, {"term": "Urgency", "definition": "The time sensitivity of a recommended action based on assessed risk or tree condition.", "topic": "Tree risk & assessment"}, {"term": "Useful life", "definition": "The period during which a tree is expected to provide its intended functional, amenity or environmental benefits.", "topic": "Urban forestry & tree management"}, {"term": "Utility pruning", "definition": "Pruning undertaken to maintain clearance from overhead or other utility infrastructure.", "topic": "Pruning & tree work"}, {"term": "Vascular cambium", "definition": "A lateral meristem producing secondary xylem inward and secondary phloem outward.", "topic": "Tree biology & anatomy"}, {"term": "Vascular tissue", "definition": "Plant conducting tissue comprising xylem and phloem.", "topic": "Tree biology & anatomy"}, {"term": "Vigour", "definition": "The ability of a tree to sustain its life processes; distinct from condition, although the two can influence each other.", "topic": "Assessment"}, {"term": "Vista pruning", "definition": "Selective pruning undertaken to create or maintain a specific view or sightline.", "topic": "Pruning & tree work"}, {"term": "Visual tree assessment", "definition": "A visual inspection method used to identify tree characteristics, defects, symptoms and structural indicators.", "topic": "Tree risk & assessment"}, {"term": "Vitality", "definition": "A tree's physiological capacity and functional performance, often considered in relation to growth and response to stress.", "topic": "Assessment"}, {"term": "Water potential", "definition": "A measure of the tendency of water to move between locations due to pressure and concentration differences.", "topic": "Tree biology & anatomy"}, {"term": "Water stress", "definition": "Physiological stress caused by inadequate water availability or excessive water loss.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Waterlogging", "definition": "Saturation of soil with water for sufficient duration to reduce oxygen availability to roots.", "topic": "Roots, soil & below-ground environment"}, {"term": "Weed tree", "definition": "A tree capable of establishing or spreading in locations where it is undesirable or environmentally harmful.", "topic": "Urban forestry & tree management"}, {"term": "Weight distribution", "definition": "The spatial distribution of tree mass that influences mechanical loading.", "topic": "Tree structure & form"}, {"term": "White rot", "definition": "A decay type in which fungi degrade lignin as well as cellulose and hemicellulose, often producing pale or fibrous wood.", "topic": "Defects, decay & disorders"}, {"term": "Whole-tree failure", "definition": "Failure involving the overturning or collapse of the entire tree.", "topic": "Tree risk & assessment"}, {"term": "Wilt", "definition": "Loss of leaf or shoot turgor caused by insufficient water status or impaired water transport.", "topic": "Tree health, vitality & diagnosis"}, {"term": "Wind loading", "definition": "Mechanical force imposed on a tree by moving air.", "topic": "Tree structure & form"}, {"term": "Wind loading path", "definition": "The sequence by which wind-generated forces are transferred through crown, branches, stem and roots.", "topic": "Tree structure & form"}, {"term": "Wind sail", "definition": "The effective crown area exposed to wind and therefore contributing to wind loading.", "topic": "Tree structure & form"}, {"term": "Windthrow", "definition": "Failure involving overturning of a tree, commonly with roots and soil mass.", "topic": "Tree structure & form"}, {"term": "Wood anatomy", "definition": "The microscopic and structural characteristics of wood used to understand its function, development and defects.", "topic": "Tree biology & anatomy"}, {"term": "Wood decay fungus", "definition": "A fungus capable of degrading structural wood components.", "topic": "Defects, decay & disorders"}, {"term": "Wood failure", "definition": "Loss of structural integrity of wood resulting in cracking, splitting, fracture or collapse.", "topic": "Defects, decay & disorders"}, {"term": "Wood fibre", "definition": "An elongated supportive cell in wood contributing to mechanical strength.", "topic": "Tree biology & anatomy"}, {"term": "Wood fracture", "definition": "A break through wood caused by loading beyond its capacity or by defects and deterioration.", "topic": "Defects, decay & disorders"}, {"term": "Wound", "definition": "An area where bark or underlying tissues have been physically damaged or removed.", "topic": "Defects, decay & disorders"}, {"term": "Wound closure", "definition": "Progressive coverage of a wound by new growth from surrounding living tissues.", "topic": "Defects, decay & disorders"}, {"term": "Woundwood", "definition": "Woody tissue produced around a wound as part of the tree's response to injury.", "topic": "Tree biology"}, {"term": "Xylem", "definition": "Woody vascular tissue that conducts water and dissolved minerals and contributes to structural support.", "topic": "Tree biology"}, {"term": "Xylem dysfunction", "definition": "Impaired water transport through xylem caused by embolism, damage, disease or other factors.", "topic": "Tree health, vitality & diagnosis"}];

const listEl = document.getElementById('list');
const searchEl = document.getElementById('search');
const topicEl = document.getElementById('topic');
const statsEl = document.getElementById('stats');
const letterJumpEl = document.getElementById('letterJump');
const clearBtn = document.getElementById('clearBtn');

// Populate topics
const topics = [...new Set(GLOSSARY.map(e => e.topic).filter(Boolean))].sort((a, b) => a.localeCompare(b));
topics.forEach(t => {
  const opt = document.createElement('option');
  opt.value = t;
  opt.textContent = t;
  topicEl.appendChild(opt);
});

function escapeHtml(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function highlight(text, query) {
  if (!query) return escapeHtml(text);
  const escaped = escapeHtml(text);
  const q = query.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  if (!q) return escaped;
  try {
    const re = new RegExp('(' + q + ')', 'gi');
    return escaped.replace(re, '<mark class="search-hit">$1</mark>');
  } catch {
    return escaped;
  }
}

function matches(entry, q, topic, letter) {
  if (topic && entry.topic !== topic) return false;
  if (letter && firstLetter(entry.term) !== letter) return false;
  if (!q) return true;
  const lower = q.toLowerCase();
  return (
    entry.term.toLowerCase().includes(lower) ||
    entry.definition.toLowerCase().includes(lower)
  );
}

function firstLetter(term) {
  const c = term.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(c) ? c : '#';
}

let activeLetter = '';

function render() {
  const q = searchEl.value.trim();
  const topic = topicEl.value;
  const filtered = GLOSSARY.filter(e => matches(e, q, topic, activeLetter));

  // Letters available under current search+topic (ignore active letter for availability)
  const baseFiltered = GLOSSARY.filter(e => matches(e, q, topic, ''));
  const present = new Set(baseFiltered.map(e => firstLetter(e.term)));
  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
  letterJumpEl.innerHTML = letters.map(L => {
    const disabled = !present.has(L);
    const active = activeLetter === L ? ' active' : '';
    return '<a href="#" role="button" class="' + (disabled ? 'disabled' : '') + active + '" data-letter="' + L + '" aria-pressed="' + (activeLetter === L) + '">' + L + '</a>';
  }).join('') + '<a href="#" role="button" class="letter-all' + (activeLetter === '' ? ' active' : '') + '" data-letter="" title="All letters">All</a>';

  statsEl.innerHTML = 'Showing <strong>' + filtered.length + '</strong> of <strong>' + GLOSSARY.length + '</strong> terms'
    + (topic ? ' · topic: <strong>' + escapeHtml(topic) + '</strong>' : '')
    + (activeLetter ? ' · letter: <strong>' + activeLetter + '</strong>' : '')
    + (q ? ' · search: <strong>' + escapeHtml(q) + '</strong>' : '');

  if (filtered.length === 0) {
    listEl.innerHTML = '<div class="empty">No terms match your search or filter.</div>';
    return;
  }

  let html = '';
  let lastLetter = null;
  filtered.forEach(e => {
    const L = firstLetter(e.term);
    if (L !== lastLetter) {
      html += '<div class="letter-heading" id="letter-' + L + '">' + L + '</div>';
      lastLetter = L;
    }
    html += '<article class="entry">'
      + '<div class="entry-header">'
      + '<span class="term">' + highlight(e.term, q) + '</span>'
      + (e.topic ? '<span class="topic-badge">' + escapeHtml(e.topic) + '</span>' : '')
      + '</div>'
      + '<p class="definition">' + highlight(e.definition, q) + '</p>'
      + '</article>';
  });
  listEl.innerHTML = html;
}

// Letter filter toggles
letterJumpEl.addEventListener('click', (ev) => {
  const a = ev.target.closest('a');
  if (!a || a.classList.contains('disabled')) return;
  ev.preventDefault();
  const L = a.getAttribute('data-letter') || '';
  // Toggle off if same letter clicked again
  activeLetter = (activeLetter === L) ? '' : L;
  render();
});

searchEl.addEventListener('input', render);
topicEl.addEventListener('change', render);
clearBtn.addEventListener('click', () => {
  searchEl.value = '';
  topicEl.value = '';
  activeLetter = '';
  render();
  searchEl.focus();
});

render();
</script>
