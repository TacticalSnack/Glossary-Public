ee protection"}, {"term": "Service trench", "definition": "A trench constructed to install, replace or maintain underground infrastructure.", "topic": "Development, construction & tree protection"}, {"term": "Shearing", "definition": "Mechanical trimming that removes large amounts of foliage or branch tips to create a defined surface or shape.", "topic": "Pruning & tree work"}, {"term": "Sieve tube", "definition": "A phloem conducting structure that transports organic assimilates.", "topic": "Tree biology & anatomy"}, {"term": "Significant tree", "definition": "A tree identified as important under defined environmental, cultural, landscape, heritage or management criteria.", "topic": "Urban forestry & tree management"}, {"term": "Sinker root", "definition": "A root growing downward from the main root system, contributing to anchorage and access to deeper soil.", "topic": "Tree biology & anatomy"}, {"term": "Site disturbance footprint", "definition": "The area likely to be physically altered by construction, access, storage or associated activities.", "topic": "Development, construction & tree protection"}, {"term": "Site supervision", "definition": "Professional observation of works to confirm compliance with specified tree-protection measures.", "topic": "Development, construction & tree protection"}, {"term": "Slime flux", "definition": "Flow or seepage of liquid from a tree, often associated with microbial activity or internal pressure.", "topic": "Defects, decay & disorders"}, {"term": "Soft rot", "definition": "A decay process that affects wood through specialised fungal activity and may occur under conditions unsuitable for other decay fungi.", "topic": "Defects, decay & disorders"}, {"term": "Soil aeration", "definition": "The availability and movement of air within soil pore spaces.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil aggregate", "definition": "A cluster of soil particles bound together into a stable structural unit.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil cell", "definition": "A modular structural system creating protected soil volume beneath pavements or other surfaces.", "topic": "Development, construction & tree protection"}, {"term": "Soil compaction", "definition": "Increase in soil bulk density and reduction in pore space caused by pressure, potentially restricting root growth, gas exchange and infiltration.", "topic": "Soils / development"}, {"term": "Soil contamination", "definition": "Presence of chemical or biological contaminants at concentrations capable of affecting soil function or tree health.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil displacement", "definition": "Movement or removal of soil from its original position, potentially affecting roots and stability.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil heave", "definition": "Upward movement of soil caused by root growth, swelling, frost, moisture changes or other processes.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil horizon", "definition": "A distinct layer within a soil profile with characteristic physical or chemical properties.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil infiltration rate", "definition": "The rate at which water enters soil from the surface.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil moisture", "definition": "Water contained within the soil profile.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil organic matter", "definition": "Carbon-rich material derived from living or formerly living organisms and incorporated into soil.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil profile", "definition": "A vertical section through soil showing its horizons and characteristics.", "topic": "Roots, soil & below-ground environment"}, {"term": "Soil structure", "definition": "The arrangement of soil particles into ag